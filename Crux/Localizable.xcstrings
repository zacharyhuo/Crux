    },
    "settings.privacy.allowRemote.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some docsets reference fonts, images or scripts hosted online. Loading them can reveal your IP address, user agent and which page you are reading to those servers. Turning this off keeps reading fully local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分 docset 会引用在线托管的字体、图片或脚本。加载这些资源会向对应服务器暴露你的 IP 地址、User-Agent 以及正在阅读的页面。关闭此项后，阅读过程完全在本地进行。"
          }
        }
      }
    },
