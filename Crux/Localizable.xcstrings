    "library.version.replace.message %@" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@\n\nEach docset keeps only one installed version. Existing versions are replaced only after successful verification. A specific version stays pinned; Latest resumes normal update checks." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@\n\n每个文档集只保留一个版本。新版本验证成功后才会替换旧版本。选择具体版本将固定该版本；选择最新版本将恢复常规更新检查。" } }
      }
    },
    "library.version.pageMissing" : {
